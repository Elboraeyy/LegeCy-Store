# Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env with real secrets to version control!

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ==========================================
# AUTHENTICATION
# ==========================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="https://your-domain.com"

# Auth.js / NextAuth v5+ secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here"

# Admin authentication secret (used internally)
# Generate with: openssl rand -base64 32
ADMIN_SECRET="your-admin-secret-here"

# ⚠️ WARNING: NEVER use NEXT_PUBLIC_ADMIN_SECRET - it exposes secrets to browser!

# ==========================================
# PAYMENT (Paymob)
# ==========================================
PAYMOB_API_KEY="your-paymob-api-key"
PAYMOB_SECRET_KEY="your-paymob-secret-key"
PAYMOB_HMAC_SECRET="your-paymob-hmac-secret"
PAYMOB_INTEGRATION_ID="your-integration-id"
PAYMOB_IFRAME_ID="your-iframe-id"

# ==========================================
# EMAIL (Resend)
# ==========================================
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Your Store <noreply@your-domain.com>"

# ==========================================
# RATE LIMITING (Upstash Redis)
# ==========================================
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ==========================================
# CRON JOBS
# ==========================================
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"

# ==========================================
# ALERTS
# ==========================================
ADMIN_ALERT_EMAIL="admin@your-domain.com"
# Optional: Slack webhook for critical alerts
# SLACK_ALERT_WEBHOOK="https://hooks.slack.com/services/xxx"

# ==========================================
# OAUTH (Optional)
# ==========================================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
FACEBOOK_CLIENT_ID="your-facebook-client-id"
FACEBOOK_CLIENT_SECRET="your-facebook-client-secret"

# ==========================================
# CLOUDINARY (Images)
# ==========================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ==========================================
# APP URL & CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_COMING_SOON_MODE="false"

# ==========================================
# ANALYTICS & PIXELS
# ==========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="your-meta-pixel-id"
NEXT_PUBLIC_CLARITY_ID="your-clarity-project-id"
