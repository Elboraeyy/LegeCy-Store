  isDefault       Boolean    @default(false)
  bundleItem      BundleItem @relation(fields: [bundleItemId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleItemId, productId])
}

model ProductOffer {
  id            String    @id @default(uuid())
  name          String
  description   String?
  offerType     String
  targetId      String?
  discountType  String    @default("PERCENTAGE")
  discountValue Decimal
  minQuantity   Int       @default(1)
  maxDiscount   Decimal?
  startDate     DateTime  @default(now())
  endDate       DateTime?
  isActive      Boolean   @default(true)
  priority      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([offerType, targetId])
  @@index([isActive])
  @@index([startDate, endDate])
}

model StoreConfig {
  key         String   @id @unique
  value       Json
  updatedAt   DateTime @updatedAt
  description String?
  updatedBy   String?
}

model Partner {
  id             String               @id @default(uuid())
  name           String
  code           String               @unique
  email          String?
  phone          String?
  commissionRate Decimal              @default(0.10)
  walletBalance  Decimal              @default(0)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  payoutDetails  Json?
  transactions   PartnerTransaction[]
}

model PartnerTransaction {
  id        String   @id @default(uuid())
  partnerId String
  type      String
  amount    Decimal
  orderId   String?
  reference String?
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())
  partner   Partner  @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@index([orderId])
}

model StoreSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  fileUrl   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model SharedWishlist {
  id        String   @id @default(uuid())
  products  String[]
  createdAt DateTime @default(now())
}

model Todo {
  id          String      @id @default(uuid())
  title       String
  description String      @default("")
  deadline    DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isCompleted Boolean     @default(false)
  createdById String
  createdBy   AdminUser   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([deadline])
  @@index([isCompleted])
  @@index([createdAt])
}

model AdminNotification {
  id            String   @id @default(uuid())
  title         String
  body          String
  category      String   @default("system") // order, inventory, review, message, restock, finance, system
  referenceId   String?
  referenceType String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([isRead])
  @@index([category])
  @@index([createdAt])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum InvestorType {
  OWNER
  PARTNER
  INVESTOR
}

enum CapitalTxType {
  DEPOSIT
  WITHDRAWAL
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}
