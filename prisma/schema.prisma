generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String?
  emailVerified       DateTime?
  image               String?
  googleId            String?              @unique
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  points              Int                  @default(0)
  phone               String?
  tags                String[]             @default([])
  notes               String?
  status              String               @default("active")
  facebookId          String?              @unique
  addresses           Address[]
  cart                Cart?
  riskProfile         CustomerRiskProfile?
  loyaltyTransactions LoyaltyTransaction[]
  orders              Order[]
  posTransactions     POSTransaction[]
  reviews             Review[]
  sessions            Session[]
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  userId      String
  orderId     String?
  type        String
  points      Int
  balance     Int
  description String?
  createdAt   DateTime @default(now())
  order       Order?   @relation(fields: [orderId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model LoyaltySettings {
  id              String   @id @default("default")
  enabled         Boolean  @default(true)
  pointsPerEgp    Float    @default(0.1)
  pointValue      Float    @default(0.1)
  minRedeemPoints Int      @default(1000)
  minOrderTotal   Int      @default(0)
  couponValidity  Int      @default(30)
  updatedAt       DateTime @updatedAt
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model AdminUser {
  id                  String           @id @default(uuid())
  email               String           @unique
  passwordHash        String
  name                String
  username            String?          @unique
  roleId              String?
  phone               String?
  nationalId          String?          @unique
  idCardImage         String?
  avatar              String?
  birthDate           DateTime?
  address             String?
  emergencyContact    String?
  position            String?
  salary              Decimal?
  hireDate            DateTime?
  notes               String?
  isActive            Boolean          @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  twoFactorEnabled    Boolean          @default(false)
  twoFactorExpiresAt  DateTime?
  twoFactorSecret     String?
  sessions            AdminSession[]
  role                AdminRole?       @relation(fields: [roleId], references: [id])
  auditLogs           AuditLog[]
  leaves              EmployeeLeave[]
  ratings             EmployeeRating[]
  completedCounts     InventoryCount[] @relation("CountCompletedBy")
  createdCounts       InventoryCount[] @relation("CountCreatedBy")
  inventoryLogs       InventoryLog[]
  orderNotes          OrderNote[]
  posSessions         POSSession[]
  salaryPayments      SalaryPayment[]
  resolvedAlerts      StockAlert[]
  approvedTransfers   StockTransfer[]  @relation("TransferApprovedBy")
  createdTransfers    StockTransfer[]  @relation("TransferCreatedBy")
  managedWarehouses   Warehouse[]
  todos               Todo[]
}

model AdminRole {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  permissions String      @default("")
  admins      AdminUser[]
}

model AdminSession {
  id        String    @id
  adminId   String
  expiresAt DateTime
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String    @id @default(uuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  admin      AdminUser @relation(fields: [adminId], references: [id])
}

model Order {
  id                  String               @id @default(uuid())
  totalPrice          Decimal
  status              String               @default("pending")
  createdAt           DateTime             @default(now())
  userId              String?
  customerName        String?
  customerEmail       String?
  customerPhone       String?
  shippingAddress     String?
  shippingCity        String?
  shippingNotes       String?
  paymentMethod       String               @default("cod")
  couponId            String?
  pointsEarned        Int                  @default(0)
  pointsRedeemed      Int                  @default(0)
  customerIP          String?
  deliveredAt         DateTime?
  discountAmount      Decimal?
  idempotencyKey      String?              @unique
  orderSource         String               @default("online")
  shippingCost        Decimal?
  shippingProvider    String?
  subtotal            Decimal?
  trackingNumber      String?
  updatedAt           DateTime             @updatedAt
  recoveryEmailSent   Boolean              @default(false)
  shippingGovernorate String?
  recoverySentAt      DateTime?
  reviewedAt          DateTime?
  reviewedBy          String?
  riskFactors         String[]
  orderNumber         Int                  @unique @default(autoincrement())
  alternativePhone    String?
  firstName           String?
  lastName            String?
  paymentPhoneNumber  String?
  paymentRef          String?
  couponUsage         CouponUsage?
  loyaltyTransactions LoyaltyTransaction[]
  coupon              Coupon?              @relation(fields: [couponId], references: [id])
  orderStatus         OrderStatusEnum      @relation(fields: [status], references: [value])
  user                User?                @relation(fields: [userId], references: [id])
  adjustments         OrderAdjustment[]
  disputes            OrderDispute[]
  events              OrderEvent[]
  items               OrderItem[]
  notes               OrderNote[]
  riskScore           OrderRiskScore?
  history             OrderStatusHistory[]
  paymentIntent       PaymentIntent?
  returnRequest       ReturnRequest?
  revenueRecognition  RevenueRecognition?

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([idempotencyKey])
  @@index([customerEmail])
  @@index([paymentMethod])
  @@index([orderSource])
}

model PaymentIntent {
  id                String                  @id @default(uuid())
  orderId           String                  @unique
  amount            Decimal
  currency          String                  @default("EGP")
  provider          String                  @default("paymob")
  providerReference String?
  status            String                  @default("pending")
  expiresAt         DateTime
  createdAt         DateTime                @default(now())
  order             Order                   @relation(fields: [orderId], references: [id])
  statusRel         PaymentIntentStatusEnum @relation(fields: [status], references: [value])
}

model ProcessedWebhookEvent {
  id          String   @id
  provider    String
  eventType   String
  entityId    String?
  processedAt DateTime @default(now())

  @@index([provider, entityId])
}

model PaymentIntentStatusEnum {
  value   String          @id
  intents PaymentIntent[]
}

model OrderStatusEnum {
  value  String  @id
  orders Order[]
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  from      String
  to        String
  reason    String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id              String     @id @default(uuid())
  productId       String
  name            String
  price           Decimal
  quantity        Int
  orderId         String
  variantId       String?
  costAtPurchase  Decimal?
  discountedPrice Decimal?
  sku             String?
  warehouseId     String?
  order           Order      @relation(fields: [orderId], references: [id])
  product         Product    @relation(fields: [productId], references: [id])
  variant         Variant?   @relation(fields: [variantId], references: [id])
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
}

model Product {
  id                    String                @id @default(uuid())
  name                  String
  description           String?
  imageUrl              String?
  compareAtPrice        Decimal?
  status                String                @default("active")
  categoryId            String?
  category              String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  brandId               String?
  materialId            String?
  costPrice             Decimal?
  supplierId            String?
  descriptionAr         String?
  detailedDescription   String?
  detailedDescriptionAr String?
  nameAr                String?
  detailTags            String[]              @default([])
  showInForYou          Boolean               @default(true)
  showInNewArrivals     Boolean               @default(true)
  metaDescription       String?
  metaDescriptionAr     String?
  metaTitle             String?
  metaTitleAr           String?
  slug                  String?               @unique
  orderedSimilarIds     String[]              @default([])
  specs                 Json?
  sortInCategory        Int                   @default(0)
  sortInBrand           Int                   @default(0)
  sortInMaterial        Int                   @default(0)
  bogoDeals             BOGOProduct[]
  bundleOptions         BundleItemProduct[]
  bundles               BundleProduct[]
  cartItems             CartItem[]
  flashSales            FlashSaleProduct[]
  orderItems            OrderItem[]
  brand                 Brand?                @relation(fields: [brandId], references: [id])
  categoryRel           Category?             @relation(fields: [categoryId], references: [id])
  material              Material?             @relation(fields: [materialId], references: [id])
  supplier              Supplier?             @relation(fields: [supplierId], references: [id])
  images                ProductImage[]
  purchaseItems         PurchaseInvoiceItem[]
  reviews               Review[]
  stockNotifications    StockNotification[]
  variants              Variant[]
  similarProducts       Product[]             @relation("SimilarProducts")
  similarTo             Product[]             @relation("SimilarProducts")

  @@index([name])
  @@index([category])
  @@index([status])
  @@index([categoryId])
  @@index([brandId])
  @@index([materialId])
  @@index([supplierId])
  @@index([showInNewArrivals])
  @@index([showInForYou])
  @@index([slug])
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  nameAr    String?
  sortOrder      Int       @default(0)
  useCustomOrder Boolean   @default(false)
  products       Product[]
}

model Material {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  nameAr    String?
  sortOrder      Int       @default(0)
  useCustomOrder Boolean   @default(false)
  products       Product[]
}

model Review {
  id        String   @id @default(uuid())
  name      String
  rating    Int
  text      String
  productId String
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  images    String[] @default([])
  userId    String?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([featured])
}

model Category {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  description   String?
  parentId      String?
  sortOrder      Int        @default(0)
  useCustomOrder Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  descriptionAr  String?
  nameAr         String?
  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryHierarchy")
  products       Product[]

  @@index([parentId])
  @@index([sortOrder])
}

model OrderNote {
  id        String    @id @default(uuid())
  orderId   String
  adminId   String
  content   String
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Variant {
  id                  String                @id @default(uuid())
  productId           String
  sku                 String                @unique
  price               Decimal
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  costPrice           Decimal?              @default(0)
  cartItems           CartItem[]
  costHistory         CostHistory[]
  inventory           Inventory[]
  inventoryBatches    InventoryBatch[]
  inventoryCountItems InventoryCountItem[]
  inventoryLogs       InventoryLog[]
  orderItems          OrderItem[]
  purchaseItems       PurchaseInvoiceItem[]
  stockAlerts         StockAlert[]
  StockNotification   StockNotification[]
  stockTransferItems  StockTransferItem[]
  product             Product               @relation(fields: [productId], references: [id])
}

model Warehouse {
  id                 String           @id @default(uuid())
  name               String           @unique
  address            String?
  city               String?
  code               String?          @unique
  country            String           @default("Egypt")
  createdAt          DateTime         @default(now())
  email              String?
  isActive           Boolean          @default(true)
  managerId          String?
  notes              String?
  phone              String?
  type               String           @default("MAIN")
  updatedAt          DateTime         @default(now()) @updatedAt
  inventory          Inventory[]
  inventoryCounts    InventoryCount[]
  inventoryLogs      InventoryLog[]
  OrderItem          OrderItem[]
  posTerminals       POSTerminal[]
  stockAlerts        StockAlert[]
  stockIns           StockInEvent[]
  stockTransfersFrom StockTransfer[]  @relation("TransferFrom")
  stockTransfersTo   StockTransfer[]  @relation("TransferTo")
  manager            AdminUser?       @relation(fields: [managerId], references: [id])
}

model Inventory {
  id          String    @id @default(uuid())
  warehouseId String
  variantId   String
  available   Int       @default(0)
  reserved    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  minStock    Int       @default(5)
  variant     Variant   @relation(fields: [variantId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, variantId])
}

model InventoryLog {
  id           String     @id @default(uuid())
  warehouseId  String
  variantId    String
  action       String
  quantity     Int
  balanceAfter Int?
  reason       String?
  referenceId  String?
  adminId      String?
  createdAt    DateTime   @default(now())
  admin        AdminUser? @relation(fields: [adminId], references: [id])
  variant      Variant    @relation(fields: [variantId], references: [id])
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId])
  @@index([variantId])
  @@index([createdAt])
  @@index([action])
}

model StockTransfer {
  id              String              @id @default(uuid())
  transferNumber  String              @unique @default(uuid())
  fromWarehouseId String
  toWarehouseId   String
  status          String              @default("PENDING")
  notes           String?
  createdById     String?
  approvedById    String?
  createdAt       DateTime            @default(now())
  approvedAt      DateTime?
  shippedAt       DateTime?
  receivedAt      DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  approvedBy      AdminUser?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  createdBy       AdminUser?          @relation("TransferCreatedBy", fields: [createdById], references: [id])
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items           StockTransferItem[]

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdAt])
}

model StockTransferItem {
  id           String        @id @default(uuid())
  transferId   String
  variantId    String
  requestedQty Int
  sentQty      Int?
  receivedQty  Int?
  notes        String?
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant      Variant       @relation(fields: [variantId], references: [id])

  @@index([transferId])
  @@index([variantId])
}

model StockAlert {
  id           String     @id @default(uuid())
  warehouseId  String
  variantId    String
  alertType    String
  threshold    Int
  currentStock Int
  status       String     @default("NEW")
  resolvedById String?
  resolvedAt   DateTime?
  resolvedNote String?
  createdAt    DateTime   @default(now())
  resolvedBy   AdminUser? @relation(fields: [resolvedById], references: [id])
  variant      Variant    @relation(fields: [variantId], references: [id])
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])

  @@index([status])
  @@index([alertType])
  @@index([warehouseId])
  @@index([variantId])
  @@index([createdAt])
}

model InventoryCount {
  id            String               @id @default(uuid())
  countNumber   String               @unique @default(uuid())
  warehouseId   String
  status        String               @default("DRAFT")
  createdById   String?
  completedById String?
  countDate     DateTime             @default(now())
  notes         String?
  createdAt     DateTime             @default(now())
  completedAt   DateTime?
  completedBy   AdminUser?           @relation("CountCompletedBy", fields: [completedById], references: [id])
  createdBy     AdminUser?           @relation("CountCreatedBy", fields: [createdById], references: [id])
  warehouse     Warehouse            @relation(fields: [warehouseId], references: [id])
  items         InventoryCountItem[]

  @@index([status])
  @@index([warehouseId])
  @@index([countDate])
}

model InventoryCountItem {
  id         String         @id @default(uuid())
  countId    String
  variantId  String
  systemQty  Int
  countedQty Int?
  variance   Int?
  notes      String?
  countedAt  DateTime?
  count      InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  variant    Variant        @relation(fields: [variantId], references: [id])

  @@index([countId])
  @@index([variantId])
}

model Cart {
  id                 String     @id @default(uuid())
  userId             String     @unique
  abandonedEmailSent Boolean    @default(false)
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              CartItem[]
}

model CartItem {
  id             String   @id @default(uuid())
  cartId         String
  productId      String
  variantId      String?
  quantity       Int      @default(1)
  bundleConfig   Json?
  contextId      String?
  pricingContext String?
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
  variant        Variant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  type        String   @default("home")
  name        String
  phone       String
  street      String
  city        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  governorate String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReturnRequest {
  id          String   @id @default(uuid())
  orderId     String   @unique
  reason      String
  items       Json?
  status      String   @default("pending")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  images      String[]
  returnType  String   @default("refund")
  order       Order    @relation(fields: [orderId], references: [id])
}

model Coupon {
  id            String        @id @default(uuid())
  code          String        @unique
  discountType  String
  discountValue Decimal
  minOrderValue Decimal?
  maxDiscount   Decimal?
  startDate     DateTime      @default(now())
  endDate       DateTime?
  usageLimit    Int?
  currentUsage  Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  usages        CouponUsage[]
  orders        Order[]

  @@index([isActive])
  @@index([startDate, endDate])
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String?
  userEmail String
  orderId   String   @unique
  usedAt    DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])

  @@unique([couponId, userId])
  @@unique([couponId, userEmail])
  @@index([couponId])
}

model ProductPriceHistory {
  id        String   @id @default(uuid())
  productId String
  variantId String?
  oldPrice  Decimal
  newPrice  Decimal
  changedBy String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

model StockNotification {
  id        String   @id @default(uuid())
  email     String?
  productId String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  variantId String?
  channel   String   @default("email")
  whatsapp  String?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   Variant? @relation(fields: [variantId], references: [id])

  @@unique([email, variantId])
  @@unique([whatsapp, productId])
  @@index([email])
  @@index([whatsapp])
  @@index([variantId])
  @@index([productId])
}

model EmailQueue {
  id          String    @id @default(uuid())
  to          String
  subject     String
  html        String
  status      String    @default("pending")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([scheduledAt])
}

model POSTerminal {
  id              String        @id @default(uuid())
  name            String        @unique
  code            String        @unique
  warehouseId     String
  printerType     String?
  printerAddress  String?
  drawerEnabled   Boolean       @default(false)
  scannerMode     String        @default("KEYBOARD")
  customerDisplay Boolean       @default(false)
  displayAddress  String?
  isActive        Boolean       @default(true)
  settings        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  quickKeys       POSQuickKey[]
  sessions        POSSession[]
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId])
  @@index([isActive])
}

model POSSession {
  id               String               @id @default(uuid())
  sessionNo        String               @unique @default(uuid())
  cashierId        String
  terminalId       String
  startedAt        DateTime             @default(now())
  endedAt          DateTime?
  openingBalance   Decimal              @default(0)
  closingBalance   Decimal?
  expectedBalance  Decimal?
  difference       Decimal?
  salesCount       Int                  @default(0)
  refundsCount     Int                  @default(0)
  voidCount        Int                  @default(0)
  salesTotal       Decimal              @default(0)
  refundsTotal     Decimal              @default(0)
  discountsTotal   Decimal              @default(0)
  taxTotal         Decimal              @default(0)
  status           String               @default("OPEN")
  closingNote      String?
  cashMovements    CashMovement[]
  heldTransactions POSHeldTransaction[]
  cashier          AdminUser            @relation(fields: [cashierId], references: [id])
  terminal         POSTerminal          @relation(fields: [terminalId], references: [id])
  transactions     POSTransaction[]

  @@index([cashierId])
  @@index([terminalId])
  @@index([status])
  @@index([startedAt])
}

model POSTransaction {
  id             String               @id @default(uuid())
  transactionNo  String               @unique
  sessionId      String
  type           String               @default("SALE")
  customerId     String?
  customerName   String?
  customerPhone  String?
  subtotal       Decimal
  discountAmount Decimal              @default(0)
  discountType   String?
  discountReason String?
  couponId       String?
  taxAmount      Decimal              @default(0)
  total          Decimal
  changeDue      Decimal              @default(0)
  status         String               @default("COMPLETED")
  voidReason     String?
  voidedById     String?
  voidedAt       DateTime?
  linkedOrderId  String?
  receiptPrinted Boolean              @default(false)
  note           String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  payments       POSPayment[]
  customer       User?                @relation(fields: [customerId], references: [id])
  session        POSSession           @relation(fields: [sessionId], references: [id])
  items          POSTransactionItem[]

  @@index([sessionId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([transactionNo])
}

model POSTransactionItem {
  id             String         @id @default(uuid())
  transactionId  String
  productId      String
  variantId      String?
  name           String
  sku            String
  barcode        String?
  imageUrl       String?
  quantity       Int
  unitPrice      Decimal
